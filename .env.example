# Select provider: ollama or azure
DSPY_PROVIDER=ollama

# Shared defaults
DSPY_TEMPERATURE=0.2
DSPY_MAX_TOKENS=300

# Ollama settings
# Pull a model first, for example: ollama pull llama3.2:3b
DSPY_OLLAMA_MODEL=ollama_chat/llama3.2:3b
DSPY_OLLAMA_API_BASE=http://localhost:11434

# Azure OpenAI settings (used only when DSPY_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE_NAME.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview
